# Copy this file to .env and replace the placeholder locally.
GOOGLE_API_KEY=replace_with_your_google_ai_studio_key

# Local development only: bypass authentication until OIDC is configured.
ROLEREADY_DEV_MODE=true

# Optional model override.
ROLEREADY_TEXT_MODEL=gemini-3.7-flash
ROLEREADY_LIVE_MODEL=gemini-3.1-flash-live-preview
